{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "code-index-kedaibuku": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "code-index-mcp",
        "--project-path",
        "C:\\laragon\\www\\kedaibukusinau"
      ]
    },
    "memory-kedaibuku": {
      "type": "local",
      "enabled": true,
      "command": [
        "cmd",
